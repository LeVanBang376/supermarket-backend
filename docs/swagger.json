                },
                "phone_number": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/definitions/supermarket-backend_internal_dto.PositionResponse"
                },
                "role": {
                    "$ref": "#/definitions/supermarket-backend_internal_dto.RoleResponse"
                },
                "status": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
